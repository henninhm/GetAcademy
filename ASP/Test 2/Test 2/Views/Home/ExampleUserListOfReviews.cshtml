@{
    ViewData["Title"] = "List Of Reviews";
}
<h1>@ViewData["Title"]</h1>

<div>
    <h5>Name of Product</h5>
    <ul>
		<li>Medium: _____ (book, movie, comic, game, song, album)</li>
		<li>Original or adaptation</li>
		<li>Review: ___________________________________________</li>
		<li>Score 1: X/5 (Overall score default)</li>
		<li>Score 2: Y/5 (Eks: Entertainment value, ‘as an adaptation’, originality, specific actor)</li>
		<li>[Link] See more scores (If there's more')</li>
		<li>[Link] Review of original/adaptation(s) (If it/they exist)</li>
		<li>[Link] Other related products/series:</li>
    </ul>
</div>
